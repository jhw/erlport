{deps, []}.
{erl_opts, [debug_info, warnings_as_errors, {i, "test"}]}.
{src_dirs, ["src", "src/python", "src/ruby", "src/go"]}.
{cover_enabled, true}.
{eunit_opts, [verbose]}.
{eunit_compile_opts, [{i, "test"}]}.
%% Support modern Python 3+, Ruby 1.9+, and Go 1.11+
{extra_src_dirs, ["test/python", "test/ruby", "test/go"]}.
